rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isPrimaryAdmin() { return signedIn() && email() == 'kangmin.j@gfutures.co'; }
    function isAdmin() {
      return isPrimaryAdmin() ||
        (signedIn() && exists(/databases/$(database)/documents/admins/$(email())));
    }

    match /admins/{adminEmail} {
      allow read, write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();

      match /tabs/{tabId} {
        allow read: if true;
        allow write: if isAdmin();

        match /collectorSettings/{settingId} {
          allow read, write: if isAdmin();
        }

        match /{publicCollection}/{docId} {
          allow read: if publicCollection in [
            'kpi',
            'files',
            'reportFiles',
            'reportComments',
            'insights',
            'creativeAssets'
          ];
          allow write: if isAdmin();

          match /{nestedCollection}/{nestedId} {
            allow read: if publicCollection in ['reportFiles'];
            allow write: if isAdmin();
          }
        }
      }
    }
  }
}
