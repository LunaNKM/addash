rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.email.lower(); }
    function isPrimaryAdmin() { return signedIn() && email() == 'kangmin.j@gfutures.co'; }
    // 회사 도메인 구글 계정은 admins에 등록하지 않아도 관리자로 본다.
    // (도메인을 바꾸면 lib/adminDomains.ts도 같이 고칠 것)
    function isCompanyAdmin() { return signedIn() && email().matches('.*@gfutures[.]co'); }
    function isAdmin() {
      return isPrimaryAdmin() || isCompanyAdmin() ||
        (signedIn() && exists(/databases/$(database)/documents/admins/$(email())));
    }

    match /admins/{adminEmail} {
      allow read, write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();

      match /tabs/{tabId} {
        allow read: if true;
        allow write: if isAdmin();

        match /collectorSettings/{settingId} {
          allow read, write: if isAdmin();
        }

        match /{publicCollection}/{docId} {
          allow read: if publicCollection in [
            'kpi',
            'files',
            'reportFiles',
            'xReportFiles',
            'reportComments',
            'insights',
            'noteHistory',
            'creativeAssets'
          ];
          allow write: if isAdmin();

          match /{nestedCollection}/{nestedId} {
            allow read: if publicCollection in ['reportFiles'];
            allow write: if isAdmin();
          }
        }
      }
    }
  }
}
